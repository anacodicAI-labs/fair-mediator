# Copy this file to .env and fill in your own values. .env is gitignored; never commit it.
#
# Load it into your shell before running notebooks or scripts:
#   set -a; source .env; set +a

# LLM calls (objection parser, LLM judge) go to Groq's OpenAI-compatible API.
# A free key from https://console.groq.com is enough.
GROQ_API_KEY=

# Optional: OpenAI key for the OpenAI-family LLM judge (gpt-4o-mini).
# Without it the judge falls back to the Groq-hosted models only.
OPENAI_API_KEY=

# Optional dataset switches (defaults shown); see data/README.md.
# FM_DATASET=small              # small | ubereats | ubereats-shuffled
# FM_CITY="Houston, TX"         # used when FM_DATASET=ubereats*
# FM_PERSONAS=small             # small | foodcom
# FM_FIGDATA=figdata            # where harness CSVs are written
# FM_SHUFFLE_SEED=7
# FM_FLAVOUR_CSV=data/shared/external/recipes_with_flavour_profiles.csv
# FM_UBEREATS_DIR=data/shared/external/ubereats
